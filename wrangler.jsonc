{
  // Project OS — Cloudflare Workers config (deployed via OpenNext)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-os",
  "main": "worker.ts",
  // The real address. workers.dev stays reachable as a fallback, but SITE_URL,
  // the sitemap and every canonical point here, so this is what has to serve.
  "routes": [
    { "pattern": "project-open-source.com", "custom_domain": true },
    { "pattern": "www.project-open-source.com", "custom_domain": true }
  ],
  "vars": {
    // The public origin. Used for the sitemap, canonicals and link previews —
    // a wrong value here points crawlers at a host that doesn't serve the page.
    "SITE_URL": "https://project-open-source.com"
  },
  "compatibility_date": "2026-07-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // D1 database — create with: npx wrangler d1 create project-os
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "project-os",
      "database_id": "23edf05c-8991-4ec7-90d7-a98b63ae16b8"
    }
  ],
  // R2 has to be switched on once in the Cloudflare dashboard before a bucket
  // can exist, so this stays commented until that's done. The upload and image
  // routes both check for the binding and return 503 rather than throwing, so
  // the only thing that breaks meanwhile is screenshot upload.
  // "r2_buckets": [{ "binding": "SHOTS", "bucket_name": "project-os-images" }],
  // Keeps the catalogue current without anyone pressing anything. The handler
  // lives in worker.ts and maps each cron to a job.
  // Without this there is no record of anything that happens in production.
  // head_sampling_rate 1 = keep every request; the volume is nowhere near the
  // point where sampling would save anything worth the blind spots.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "triggers": {
    "crons": [
      "17 3 * * *",   // discover — new projects on GitHub
      "37 4 * * *",   // refresh — stars, forks, descriptions, star snapshot
      "11 */6 * * *"  // forks — rolling fork lists, oldest first
    ]
  }
}
